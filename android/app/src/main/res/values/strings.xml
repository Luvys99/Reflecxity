    <!-- 시작하기 (#80) -->
    <string name="intro_hero_title">어디서든 내 목소리로,\n외국어로 말해요</string>
    <string name="intro_hero_body">여행 전에 5분만 녹음하면\n번역한 문장을 내 목소리로 들려 드려요</string>
    <string name="intro_steps_title">이렇게 사용해요</string>
    <string name="intro_steps_body">처음 한 번만 녹음하고 학습하면 돼요</string>
    <string name="intro_step1_title">녹음하기</string>
    <string name="intro_step1_time">5분</string>
    <string name="intro_step1_body">조용한 곳에서 책이나 기사를 소리 내어 읽어 주세요. 여러 번 나눠 녹음해도 돼요.</string>
    <string name="intro_step2_title">목소리 학습</string>
    <string name="intro_step2_time">약 5분</string>
    <string name="intro_step2_body">서버가 내 목소리를 배우고, 목소리 높이도 자동으로 맞춰요. 앱을 꺼도 계속돼요.</string>
    <string name="intro_step3_title">내 목소리로 말하기</string>
    <string name="intro_step3_time">약 3초</string>
    <string name="intro_step3_body">한국어로 쓰거나 말하면 영어로 번역해 내 목소리로 들려 드려요.</string>
    <string name="intro_ready_title">녹음 전에 준비해요</string>
    <string name="intro_ready_body">좋은 녹음이 내 목소리와 더 닮은 결과를 만들어요</string>
    <string name="intro_ready1_title">조용한 곳</string>
    <string name="intro_ready1_body">TV, 음악, 바람 소리가 없는 곳이 좋아요.</string>
    <string name="intro_ready2_title">읽을 글</string>
    <string name="intro_ready2_body">책, 기사, 블로그 무엇이든 괜찮아요. 녹음 화면에서도 글을 보여 드려요.</string>
    <string name="intro_ready3_title">인터넷 연결</string>
    <string name="intro_ready3_body">학습과 번역은 서버에서 해요.</string>
    <string name="intro_next">다음</string>
    <string name="intro_start">시작하기</string>
