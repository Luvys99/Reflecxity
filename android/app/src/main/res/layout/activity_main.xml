<?xml version="1.0" encoding="utf-8"?>
<!-- 번역 화면 (#84): 방향 → 입력 카드 → 결과 카드(내 목소리로 듣기) → 말하기 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/full"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/custom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sand"
        android:theme="@style/ThemeOverlay.AppCompat.Light">

        <ImageView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            app:srcCompat="@drawable/reflecxity_logo_small" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- 번역 방향 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/selectTv2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/pretendard_semibold"
                android:gravity="center"
                android:text="@string/kor"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/switchLanguage"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_step_number"
                android:contentDescription="@string/translate_switch"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/switch_language"
                app:tint="@color/sky" />

            <TextView
                android:id="@+id/targetTv2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/pretendard_semibold"
                android:gravity="center"
                android:text="@string/eng"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 입력 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/selectTv1"
                style="@style/TextAppearance.Reflecxity.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kor" />

            <EditText
                android:id="@+id/inputText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/input_hint"
                android:imeOptions="actionNext"
                android:inputType="textMultiLine"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink3"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 결과 + 내 목소리로 듣기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_result"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/targetTv1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="@string/eng"
                    android:textColor="@color/sky_dark"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/ttsstart_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/translate_try_guide"
                    android:textColor="@color/sunset_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/translatedText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:hint="@string/result_hint"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink3"
                android:textSize="20sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tts"
                    style="@style/Widget.Reflecxity.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/translate_listen"
                    android:textSize="16sp"
                    app:icon="@drawable/record_voice_over"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="22dp" />

                <ProgressBar
                    android:id="@+id/progressBar_ttsloading"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/sky"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recognizeButton"
        style="@style/Widget.Reflecxity.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:minHeight="56dp"
        android:text="@string/translate_speak"
        android:textSize="16sp"
        app:icon="@drawable/record"
        app:iconGravity="textStart"
        app:iconPadding="10dp" />
</LinearLayout>
