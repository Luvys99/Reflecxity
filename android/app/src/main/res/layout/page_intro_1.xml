<?xml version="1.0" encoding="utf-8"?>
<!-- 소개 1: 브랜드 (#80) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:importantForAccessibility="no"
        android:src="@drawable/hero_voice_trip" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/pretendard_bold"
        android:text="@string/app_name"
        android:textColor="@color/ink"
        android:textSize="40sp" />

    <TextView
        style="@style/TextAppearance.Reflecxity.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/intro_hero_title"
        android:textSize="22sp" />

    <TextView
        style="@style/TextAppearance.Reflecxity.Body.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/intro_hero_body" />
</LinearLayout>
