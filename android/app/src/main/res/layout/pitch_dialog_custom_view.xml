<?xml version="1.0" encoding="utf-8"?>
<!-- 목소리 높이 창 (#87): 설명 + 지금 값 + −12 ~ +12 슬라이더 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        style="@style/TextAppearance.Reflecxity.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pitch_body"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/pitch"
        style="@style/TextAppearance.Reflecxity.Number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:textSize="26sp" />

    <SeekBar
        android:id="@+id/seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:progressTint="@color/sky"
        android:thumbTint="@color/sky" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.Reflecxity.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pitch_low"
            android:textSize="12sp" />

        <TextView
            style="@style/TextAppearance.Reflecxity.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:gravity="center"
            android:text="@string/pitch_mid"
            android:textSize="12sp" />

        <TextView
            style="@style/TextAppearance.Reflecxity.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/pitch_high"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
