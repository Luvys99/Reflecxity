<?xml version="1.0" encoding="utf-8"?>
<!-- 학습 중·완료·실패 (#93): 남은 시간 → 단계 → 기다리는 동안 → 버튼 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sand"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp">

            <!-- 학습 중: 원형 진행 + 남은 시간 / 끝나면 status_icon -->
            <FrameLayout
                android:layout_width="168dp"
                android:layout_height="168dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    app:indicatorColor="@color/sky"
                    app:indicatorSize="168dp"
                    app:trackColor="@color/sand_dark"
                    app:trackCornerRadius="5dp"
                    app:trackThickness="10dp" />

                <LinearLayout
                    android:id="@+id/eta_box"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_eta_label"
                        style="@style/TextAppearance.Reflecxity.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/training_remaining_label" />

                    <TextView
                        android:id="@+id/txt_eta"
                        style="@style/TextAppearance.Reflecxity.Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/training_preparing"
                        android:textSize="26sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/status_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="40dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/cloud_done" />
            </FrameLayout>

            <TextView
                android:id="@+id/info_title"
                style="@style/TextAppearance.Reflecxity.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/training_title"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/info_txt"
                style="@style/TextAppearance.Reflecxity.Body.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/training_body"
                android:textSize="14.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="4dp"
                android:paddingEnd="18dp"
                android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp">

                    <ProgressBar
                        android:id="@+id/progressBar_creationStatus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminateTint="@color/sky" />

                    <ImageView
                        android:id="@+id/imageView_creationStatus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/check_circle"
                        app:tint="@color/success" />
                </FrameLayout>

                <TextView
                    android:id="@+id/user_creation_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/step_prepare"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/sand_dark" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp">

                    <ProgressBar
                        android:id="@+id/progressBar_uploadStatus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminateTint="@color/sky" />

                    <ImageView
                        android:id="@+id/imageView_uploadStatus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/check_circle"
                        app:tint="@color/success" />
                </FrameLayout>

                <TextView
                    android:id="@+id/file_upload_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/step_upload"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/sand_dark" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp">

                    <ProgressBar
                        android:id="@+id/progressBar_modelRequest"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminateTint="@color/sky" />

                    <ImageView
                        android:id="@+id/imageView_modelRequest"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/check_circle"
                        app:tint="@color/success" />
                </FrameLayout>

                <TextView
                    android:id="@+id/model_creation_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/step_request"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/sand_dark" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="26dp">

                    <ProgressBar
                        android:id="@+id/progressBar_modelStatus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminateTint="@color/sky" />

                    <ImageView
                        android:id="@+id/imageView_modelStatus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/check_circle"
                        app:tint="@color/success" />
                </FrameLayout>

                <TextView
                    android:id="@+id/model_creation_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/step_train"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tips_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Reflecxity.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/training_tips_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:text="@string/training_tip1"
                    android:textColor="@color/ink2"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:text="@string/training_tip2"
                    android:textColor="@color/ink2"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_button"
            style="@style/Widget.Reflecxity.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/training_restart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next_button"
            style="@style/Widget.Reflecxity.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/training_done_button" />
    </FrameLayout>
</LinearLayout>
