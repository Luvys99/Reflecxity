# 이 파일을 .env로 복사해서 값을 채운다 (.env는 git에 올리지 않는다)
# 환경 변수가 config.ini 값보다 우선한다

# DB 계정 (필수)
DB_USER=reflecxity
DB_PASSWORD=change-me
# Docker로 MariaDB를 띄울 때 쓰는 root 비밀번호 (Main Server는 쓰지 않음)
DB_ROOT_PASSWORD=change-me-too

# Redis 비밀번호 (필수, docker-compose.yml이 씀). 예: openssl rand -hex 24
REDIS_PASSWORD=change-me-three
# 이 Mac의 Tailscale 주소 (tailscale ip -4). Windows 워커가 Redis에 붙는 통로
TAILSCALE_IP=100.x.x.x

# 필요할 때만 (없으면 config.ini 값을 씀)
# DB_HOST=localhost
# DB_NAME=reflecxity
# Model Server가 다른 컴퓨터에 있을 때 (예: Windows GPU 컴퓨터)
# MODEL_SERVER_URL=http://192.168.219.105:48000

# 학습 시간 초과 (초, 없으면 10분). 워커가 꺼낸 뒤 이 시간이 지나도 안 끝나면 modelcheck가 실패로 응답
# MODEL_GENERATION_TIMEOUT=600
# TTS 결과를 기다리는 최대 시간 (초, 없으면 90초). 넘으면 504
# TTS_WAIT_SECONDS=90

# Redis가 다른 컴퓨터에 있을 때만 (없으면 127.0.0.1:6379)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
